generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMINISTRADOR
  ENCARGADO_ORGANISMO
  ENCARGADO_COMEDOR
  FELIGRES
  SECRETARIA
}

enum TipoSacramento {
  BAUTISMO
  PRIMERA_COMUNION
  CONFIRMACION
  MATRIMONIO
  UNCION_ENFERMOS
}

enum EstadoSolicitud {
  PENDIENTE
  OBSERVADA
  APROBADA
  RECHAZADA
  CANCELADA
  REALIZADA
}

model Usuario {
  id            String          @id @default(cuid())
  nombre        String
  email         String          @unique
  password      String
  tokenVersion  Int             @default(0)
  recuperacionHash   String?   @unique
  recuperacionExpira DateTime?
  rol           Rol
  organismo     Organismo?      @relation(fields: [organismoId], references: [id])
  organismoId   String?
  createdAt     DateTime        @default(now())
  publicaciones Publicacion[]
  hitos         HitoHistorico[]
  solicitudesSacramento SolicitudSacramento[]
}

model Organismo {
  id            String        @id @default(cuid())
  nombre        String
  descripcion   String?
  activo        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  publicaciones Publicacion[]
  encargados    Usuario[]
}

model Publicacion {
  id          String    @id @default(cuid())
  titulo      String
  contenido   String
  imagenes    String[] @default([])
  autor       Usuario   @relation(fields: [autorId], references: [id])
  autorId     String
  organismo   Organismo @relation(fields: [organismoId], references: [id])
  organismoId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model HitoHistorico {
  id          String       @id @default(cuid())
  titulo      String
  descripcion String
  fecha       DateTime
  autor       Usuario      @relation(fields: [autorId], references: [id])
  autorId     String
  fotos       FotoHito[]
  testimonios Testimonio[]
  createdAt   DateTime     @default(now())
}

model FotoHito {
  id     String        @id @default(cuid())
  url    String
  hito   HitoHistorico @relation(fields: [hitoId], references: [id])
  hitoId String
}

model Testimonio {
  id          String        @id @default(cuid())
  autorNombre String
  contenido   String
  hito        HitoHistorico @relation(fields: [hitoId], references: [id])
  hitoId      String
  createdAt   DateTime      @default(now())
}

model HorarioSacramento {
  id          String                @id @default(cuid())
  tipo        TipoSacramento
  inicio      DateTime
  cupos       Int                   @default(1)
  lugar       String?
  activo      Boolean               @default(true)
  solicitudes SolicitudSacramento[]
  createdAt   DateTime              @default(now())

  @@index([tipo, inicio])
}

model SolicitudSacramento {
  id                 String               @id @default(cuid())
  estado             EstadoSolicitud      @default(PENDIENTE)
  nombreBeneficiario String
  comentario         String?
  observacion        String?
  solicitante        Usuario              @relation(fields: [solicitanteId], references: [id])
  solicitanteId      String
  horario            HorarioSacramento    @relation(fields: [horarioId], references: [id])
  horarioId          String
  documentos         DocumentoSolicitud[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([estado])
}

model DocumentoSolicitud {
  id             String              @id @default(cuid())
  tipoDocumento  String
  archivo        String
  nombreOriginal String
  solicitud      SolicitudSacramento @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  solicitudId    String
  createdAt      DateTime            @default(now())
}
